# ===== API TOTVS RM =====
# Deixe TOTVS_BASE_URL vazio para subir em modo demonstração (dados fictícios)
TOTVS_BASE_URL=https://institutoadventista160181.rm.cloudtotvs.com.br:8051
TOTVS_USUARIO=
TOTVS_SENHA=
TOTVS_CONSULTA=FAAMACPA.6
TOTVS_COLIGADA=5
TOTVS_SISTEMA=S
TOTVS_TIMEOUT=600
TOTVS_VERIFICAR_SSL=true

# ===== Sistema =====
MODO_DEMO=false
CACHE_MINUTOS=60
MIN_RESPONDENTES=5
NOME_INSTITUICAO=FAAMA
# Data de encerramento da avaliação em andamento (mostra os dias restantes na página inicial)
PRAZO_AVALIACAO=2026-11-15
# Encerra a sessão após X minutos sem uso
SESSAO_MINUTOS=60
# Cursos que não entram na avaliação (separados por ;) - os mesmos filtrados no Power BI
# Separação das provas: por padrão, prova com "Infraestrutura" no nome vai para a página Infraestrutura
# e as demais provas institucionais vão para Avaliação do Curso. Para fixar por código, use PROVAS_INFRAESTRUTURA=20
PALAVRA_PROVA_INFRA=Infraestrutura
PROVAS_INFRAESTRUTURA=
# Questões aplicadas por engano: prova:matéria:questão, separadas por ;
# (padrão: as duas questões do Direito que estavam na prova 31 da Psicologia)
QUESTOES_ANULADAS=31:2:15;31:2:16
CURSOS_EXCLUIDOS=Curso de Extensão em Liderança Eclesiástica para AFAM;Iniciação Científica;Música;Oficinas;Pedagogia EAD

# Consulta de participação (sql/participacao.sql), para o Ranking de Participação. Ex.: FAAMACPA.7
TOTVS_CONSULTA_PARTICIPACAO=
